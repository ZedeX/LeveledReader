{
  "name": "leveled-reader-worker",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute leveled-reader-db --local --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute leveled-reader-db --local --file=src/db/seed.sql",
    "db:init:remote": "wrangler d1 execute leveled-reader-db --remote --file=src/db/schema.sql",
    "db:seed:remote": "wrangler d1 execute leveled-reader-db --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.100.0"
  }
}
